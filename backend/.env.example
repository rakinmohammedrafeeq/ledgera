# Database Configuration
DB_URL=jdbc:postgresql://your-db-host/your-database?sslmode=require
DB_USERNAME=your_username
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your-secret-key-at-least-256-bits-long-for-hs256-algorithm
JWT_EXPIRATION=86400000

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Ledgera

# Application Configuration
APP_BASE_URL=http://localhost:5173

# Vector Embeddings Configuration
# Set to true in production to disable local embedding model (saves ~500MB RAM)
# RAG features will be disabled, but core financial tracking works fine
DISABLE_EMBEDDINGS=false

# AI Configuration (Multi-Provider with Cross-Provider Auto-Fallback)

# ═══════════════════════════════════════════════════════════════════
# CROSS-PROVIDER FALLBACK SYSTEM
# ═══════════════════════════════════════════════════════════════════
# Models are tried in order. If one hits rate limits, the next is tried.
# You can mix Gemini and Groq models - they act as each other's fallbacks!
#
# Example fallback chain for VISION:
# 1. Try Gemini Vision Primary
# 2. If rate limited → Try Gemini Vision Fallback1
# 3. If rate limited → Try Gemini Vision Fallback2  
# 4. If rate limited → Try Gemini Vision Fallback3
# 5. If rate limited → Try Groq Vision Model
#
# This ensures maximum uptime and resilience!
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# GEMINI API KEY (Required for all Gemini models)
# ═══════════════════════════════════════════════════════════════════
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# ═══════════════════════════════════════════════════════════════════
# VISION Models (Support images/PDFs/video analysis)
# Used for: Receipt OCR, image understanding
# Fallback order: PRIMARY → FALLBACK1 → FALLBACK2 → FALLBACK3 → FALLBACK4 → GROQ
# ═══════════════════════════════════════════════════════════════════
GEMINI_VISION_PRIMARY=gemini-3.6-flash
GEMINI_VISION_FALLBACK1=gemini-flash-latest
GEMINI_VISION_FALLBACK2=gemini-3.8-flash
GEMINI_VISION_FALLBACK3=gemini-3.5-flash-lite
GEMINI_VISION_FALLBACK4=gemini-3.1-flash-lite

# ═══════════════════════════════════════════════════════════════════
# TEXT-ONLY Models (Best limits for text processing)
# Used for: Categorization, insights, advisor responses
# Fallback order: PRIMARY → FALLBACK1 → FALLBACK2 → FALLBACK3 → FALLBACK4 → GROQ
# ═══════════════════════════════════════════════════════════════════
GEMINI_TEXT_PRIMARY=gemini-3.6-flash
GEMINI_TEXT_FALLBACK1=gemini-flash-latest
GEMINI_TEXT_FALLBACK2=gemini-3.8-flash
GEMINI_TEXT_FALLBACK3=gemini-3.5-flash-lite
GEMINI_TEXT_FALLBACK4=gemini-3.1-flash-lite

# ═══════════════════════════════════════════════════════════════════
# GROQ API Configuration (Fast, generous free quota)
# Active free models: groq/compound-mini, openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# ═══════════════════════════════════════════════════════════════════
# Get your key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key
GROQ_TEXT_MODEL=groq/compound-mini
GROQ_TEXT_FALLBACK1=openai/gpt-oss-120b
GROQ_TEXT_FALLBACK2=openai/gpt-oss-20b
GROQ_TEXT_FALLBACK3=qwen/qwen3.8-27b
GROQ_TEXT_FALLBACK4=groq/compound

GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_AGENT_FALLBACK1=openai/gpt-oss-20b
GROQ_AGENT_FALLBACK2=qwen/qwen3.8-27b

GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_FALLBACK1=qwen/qwen3.8-27b

# ═══════════════════════════════════════════════════════════════════
# Rate Limit Configuration
# ═══════════════════════════════════════════════════════════════════
AI_MAX_CATEGORIZATION_REQUESTS_PER_DAY=100
AI_MAX_RECEIPT_UPLOADS_PER_DAY=20
AI_RETRY_ATTEMPTS=3
AI_RETRY_DELAY_MS=1000

# Cloudinary Configuration (Image Storage)
# Get your credentials: https://cloudinary.com/users/register_free
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# OAuth2 Frontend Redirect URI
# This is where users are redirected AFTER successful OAuth login (frontend callback URL)
APP_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/callback

# Admin Seeding (default: true for development)
LEDGERA_SEED_ADMIN=true
